# Do not commit the populated .env file.
MCP_API_KEY=replace-with-a-unique-secret
AIRTABLE_BASE_ID=appcyTYF3nQqgReHR
AIRTABLE_API_KEY=replace-with-an-Airtable-PAT

# The local NovaPay service already running on the EC2 host.
NOVAPAY_URL=http://127.0.0.1:8082/api/create-session
NOVAPAY_STATUS_URL=http://127.0.0.1:8082/api/session-status

# Set this when the payment-delivery integration is available. The server sends
# paymentUrl, mobileNumber, email, webexCalling, amount, and sessionId in a JSON
# POST request. The webhook chooses SMS for personal US mobiles and email for
# Webex Calling profiles.
PAYMENT_DELIVERY_WEBHOOK_URL=

HOST=127.0.0.1
PORT=8086
PAYMENT_LEDGER_PATH=/opt/mcp/LAB-31207/.data/payment-ledger.sqlite3
